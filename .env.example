# Kopieer dit bestand naar .env en vul je eigen Supabase-sleutels in.
#
# Je vindt ze in Supabase onder:  Settings  ->  API Keys
#
# Zonder deze twee regels werkt de app ook, maar dan blijft alles lokaal
# op je eigen toestel staan (handig om eerst te testen).

EXPO_PUBLIC_SUPABASE_URL=https://jouw-project.supabase.co

# Dit is de PUBLIEKE sleutel — die hoort in de app te staan, dat is normaal.
# Nieuwe projecten: begint met  sb_publishable_
# Oudere projecten: begint met  eyJ   (heet daar "anon public")
# Allebei werken.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Wat je NOOIT hier zet: de "secret key" of "service_role" sleutel.
# Die geeft volledige toegang en hoort alleen op een server thuis.
